{
  "$ref": "#/definitions/configuration",
  "definitions": {
    "configuration": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "number",
          "const": 1
        },
        "project": {
          "type": "object",
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "uid",
            "name"
          ],
          "additionalProperties": false
        },
        "documents": {
          "type": "object",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/configuration/properties/project/properties/name"
              },
              "minItems": 1
            },
            "exclude": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/configuration/properties/project/properties/name"
              },
              "default": []
            }
          },
          "required": [
            "include"
          ],
          "additionalProperties": false
        },
        "records_root": {
          "type": "string",
          "minLength": 1,
          "default": ".requirements"
        },
        "specifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uid": {
                "$ref": "#/definitions/configuration/properties/project/properties/uid"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "title": {
                "$ref": "#/definitions/configuration/properties/project/properties/name"
              },
              "version_label": {
                "type": "string"
              }
            },
            "required": [
              "uid",
              "code",
              "title"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "boolean",
                  "integer",
                  "date",
                  "enum",
                  "string[]",
                  "boolean[]",
                  "integer[]",
                  "date[]",
                  "enum[]"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "change_class": {
                "type": "string",
                "enum": [
                  "content",
                  "scope",
                  "administrative"
                ]
              }
            },
            "required": [
              "type",
              "change_class"
            ],
            "additionalProperties": false
          },
          "default": {}
        },
        "policy": {
          "type": "object",
          "properties": {
            "approval": {
              "type": "object",
              "properties": {
                "minimum_reviews": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "require_distinct_author": {
                  "type": "boolean",
                  "default": false
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/configuration/properties/project/properties/name"
                  },
                  "default": []
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "removal": {
              "type": "string",
              "const": "require_retirement",
              "default": "require_retirement"
            },
            "unknown_fields": {
              "type": "string",
              "const": "error",
              "default": "error"
            },
            "review_impact": {
              "type": "string",
              "const": "conservative",
              "default": "conservative"
            },
            "require_rationale": {
              "type": "boolean",
              "default": false
            },
            "require_acceptance": {
              "type": "boolean",
              "default": false
            },
            "require_change_record": {
              "type": "boolean",
              "default": false
            },
            "validation": {
              "type": "object",
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "enum": [
                          "POLICY_OWNER",
                          "POLICY_TAGS",
                          "POLICY_FIELD",
                          "POLICY_VERIFICATION",
                          "POLICY_IMPLEMENTATION",
                          "POLICY_APPROVAL"
                        ]
                      },
                      "severity": {
                        "type": "string",
                        "enum": [
                          "error",
                          "warning",
                          "off"
                        ]
                      },
                      "field": {
                        "$ref": "#/definitions/configuration/properties/project/properties/name"
                      },
                      "specification": {
                        "$ref": "#/definitions/configuration/properties/project/properties/name"
                      },
                      "lifecycle": {
                        "type": "string",
                        "enum": [
                          "draft",
                          "active",
                          "retired"
                        ]
                      },
                      "disposition": {
                        "type": "string",
                        "enum": [
                          "in_scope",
                          "deferred",
                          "not_applicable",
                          "transferred"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "severity"
                    ],
                    "additionalProperties": false
                  },
                  "default": []
                },
                "waivers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "uid": {
                        "$ref": "#/definitions/configuration/properties/project/properties/uid"
                      },
                      "rule": {
                        "$ref": "#/definitions/configuration/properties/policy/properties/validation/properties/rules/items/properties/code"
                      },
                      "subject": {
                        "$ref": "#/definitions/configuration/properties/project/properties/uid"
                      },
                      "reason": {
                        "$ref": "#/definitions/configuration/properties/project/properties/name"
                      },
                      "issuer": {
                        "$ref": "#/definitions/configuration/properties/project/properties/name"
                      },
                      "expires_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "uid",
                      "rule",
                      "subject",
                      "reason",
                      "issuer"
                    ],
                    "additionalProperties": false
                  },
                  "default": []
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "baseline": {
              "type": "object",
              "properties": {
                "approval": {
                  "type": "boolean",
                  "default": false
                },
                "implementation": {
                  "type": "boolean",
                  "default": false
                },
                "verification": {
                  "type": "boolean",
                  "default": false
                },
                "currency": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/configuration/properties/extensions/additionalProperties"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/configuration/properties/extensions/additionalProperties"
                }
              }
            ]
          },
          "default": {}
        }
      },
      "required": [
        "format_version",
        "project",
        "documents",
        "specifications"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
